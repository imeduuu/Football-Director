{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competition rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "format", "teams", "homeAndAway", "points", "tiebreakers", "movement", "registration", "discipline"],
  "properties": {
    "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "format": { "type": "string", "minLength": 1 }, "teams": { "type": "integer", "minimum": 2 }, "homeAndAway": { "type": "boolean" },
    "points": { "type": "object", "additionalProperties": false, "required": ["win", "draw", "loss"], "properties": { "win": { "type": "integer", "minimum": 1 }, "draw": { "type": "integer", "minimum": 0 }, "loss": { "type": "integer", "minimum": 0 } } },
    "tiebreakers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "movement": { "type": "object", "additionalProperties": false, "required": ["promotedDirect", "relegatedDirect", "playoffPlaces"], "properties": { "promotedDirect": { "type": "integer", "minimum": 0 }, "relegatedDirect": { "type": "integer", "minimum": 0 }, "playoffPlaces": { "type": "integer", "minimum": 0 } } },
    "registration": { "type": "object", "additionalProperties": false, "required": ["windows", "quotas"], "properties": { "windows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "start", "end"], "properties": { "name": { "type": "string" }, "start": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$" }, "end": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$" } } } }, "quotas": { "type": "object", "additionalProperties": false, "required": ["seniorMaximum", "eligibleYouthOutsideQuota", "appliesTo"], "properties": { "seniorMaximum": { "type": "integer", "minimum": 0 }, "eligibleYouthOutsideQuota": { "type": "integer", "minimum": 0 }, "appliesTo": { "type": "string" }, "maximumExtraCommunityRegistered": { "type": "integer", "minimum": 0 }, "maximumExtraCommunityStarters": { "type": "integer", "minimum": 0 } } } } },
    "discipline": { "type": "object", "additionalProperties": false, "required": ["yellowAccumulation", "directRed", "yellowScope", "redService", "processingOrder"], "properties": { "yellowAccumulation": { "type": "object", "additionalProperties": false, "required": ["threshold", "suspensionMatches"], "properties": { "threshold": { "type": "integer", "minimum": 1 }, "suspensionMatches": { "type": "integer", "minimum": 1 } } }, "directRed": { "type": "object", "additionalProperties": false, "required": ["minimumMatches", "additionalMatches"], "properties": { "minimumMatches": { "type": "integer", "minimum": 1 }, "additionalMatches": { "type": "integer", "minimum": 0 } } }, "yellowScope": { "type": "string" }, "redService": { "type": "string" }, "processingOrder": { "type": "string" } } }
  }
}
